package ssafy_coding_test;

import java.io.*;
import java.util.*;

public class Solution_4012_박찬영 {
	
	public static int N, answer;
	public static int [] ab;
	public static int [][] arr;
	
	public static void main(String[] args) throws Exception {
	BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
	StringTokenizer st;
	StringBuilder sb = new StringBuilder();
	
	int T = Integer.parseInt(br.readLine());
	
	for (int t = 1; t<= T; t++) {
		N = Integer.parseInt(br.readLine());
		arr = new int[N][N];
		
		for (int i = 0; i< N;i++) {
			st = new StringTokenizer(br.readLine());
			for(int j = 0; j < N; j++) {
				arr[i][j] = Integer.parseInt(st.nextToken());
			}
			
		}
	
	
	ab = new int [N/2];
	answer = Integer.MAX_VALUE;
	
	dfs(0,-1);
	
	sb.append('#').append(t).append(' ').append(answer).append('\n');
	}
	System.out.println(sb);
	
	}
	 
	public static void dfs(int size, int last) {
		if (size == N /2) {
			
			boolean[] selected = new boolean[N];
            for (int x : ab) selected[x] = true;

            int a = 0, b = 0; 
            
            for (int i = 0; i < N; i++) {
                for (int j = i + 1; j < N; j++) {     
                    if (selected[i] && selected[j]) a += arr[i][j] + arr[j][i];
                    
                    if (!selected[i] && !selected[j]) b += arr[i][j] + arr[j][i];
                }
            }

            
            answer = Math.min(answer, Math.abs(a - b));
            return; 
        }

        
        for (int i = last + 1; i < N; i++) {
            ab[size] = i;       
            dfs(size + 1, i);   
        }
    }
}